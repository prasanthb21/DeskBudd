{
  "name": "deskbudd",
  "version": "1.0.0",
  "description": "An animated desktop character that walks over, reacts with real expressions, and reminds you to drink water, take standup breaks, run focus sessions, and catch reminders — on whichever monitor you're actually looking at.",
  "main": "main.js",
  "author": "Prasanth B",
  "license": "MIT",
  "homepage": "https://github.com/prasanthb21/DeskBudd",
  "repository": {
    "type": "git",
    "url": "https://github.com/prasanthb21/DeskBudd.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.deskbudd.app",
    "productName": "DeskBudd",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "icon.png",
      "icon-tray-mac.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DeskBudd uses your microphone only when you hold-click the character to give it a voice command. Audio is processed entirely on your device and never sent anywhere."
      },
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": null
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
